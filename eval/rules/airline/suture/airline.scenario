scenario "the higher of oversize and overweight applies, and the 5th bag pays the 4th row":
  given a Region US with name "U.S."
  given a Trip T with region US, class "Main Cabin", way "from" and ticket 100 USD
  given a Rate R3 with region US, class "Main Cabin", way "from", nth 3 and amount 150 USD
  given a Rate R4 with region US, class "Main Cabin", way "from", nth 4 and amount 200 USD
  given a Charge S0 with region US, lowsize 0, highsize 62, lowweight 0, highweight 1000 and amount 0 USD
  given a Charge S2 with region US, lowsize 65, highsize 115, lowweight 0, highweight 1000 and amount 200 USD
  given a Charge W0 with region US, lowsize 0, highsize 1000, lowweight 0, highweight 50 and amount 0 USD
  given a Charge W2 with region US, lowsize 0, highsize 1000, lowweight 53, highweight 70 and amount 100 USD
  given a Bag B with trip T, nth 5, weight 60, length 50, width 30 and height 20
  when clerk C weighs B
  expect B's Base is done
  expect B's Paid is done
  expect B is not waived

scenario "Business: the free allowance goes to the bags it saves most on":
  given a Region US with name "U.S."
  given a Trip T with region US, class "Business", way "from" and ticket 100 USD
  given a Bag Big with trip T, nth 1, weight 60, length 50, width 30 and height 20
  given a Bag Snug with trip T, nth 2, weight 60, length 20, width 20 and height 10
  given a Bag Close with trip T, nth 3, weight 60, length 30, width 20 and height 14
  given a Bag Plump with trip T, nth 4, weight 52, length 20, width 20 and height 10
  given an Allowance A1 with trip T and nth 1
  given an Allowance A2 with trip T and nth 2
  given an Allowance A3 with trip T and nth 3
  expect Snug is waived
  expect Close is waived
  expect Plump is not waived
  expect Big is not waived

scenario "First outside the U.S. frees a third bag":
  given a Region EU with name "Europe"
  given a Trip T with region EU, class "First", way "to" and ticket 700 USD
  given a Bag B1 with trip T, nth 1, weight 60, length 20, width 20 and height 10
  given a Bag B2 with trip T, nth 2, weight 60, length 20, width 20 and height 10
  given a Bag B3 with trip T, nth 3, weight 52, length 20, width 20 and height 10
  given an Allowance A1 with trip T and nth 1
  given an Allowance A2 with trip T and nth 2
  given an Allowance A3 with trip T and nth 3
  expect B3 is waived

scenario "Main Cabin frees one bag's allowance only to Australia or New Zealand":
  given a Region AU with name "Australia"
  given a Region MX with name "Mexico"
  given a Trip Far with region AU, class "Main Cabin", way "to" and ticket 500 USD
  given a Trip Near with region MX, class "Main Cabin", way "to" and ticket 100 USD
  given a Bag F1 with trip Far, nth 1, weight 60, length 20, width 20 and height 10
  given a Bag F2 with trip Far, nth 2, weight 60, length 20, width 20 and height 10
  given a Bag N1 with trip Near, nth 1, weight 60, length 20, width 20 and height 10
  given an Allowance FA1 with trip Far and nth 1
  given an Allowance FA2 with trip Far and nth 2
  given an Allowance NA1 with trip Near and nth 1
  expect F1 is waived
  expect F2 is not waived
  expect N1 is not waived

scenario "a waived bag takes its row from the free allowance's table":
  given a Region US with name "U.S."
  given a Trip T with region US, class "Business", way "from" and ticket 100 USD
  given a Grace G0 with region US, lowsize 0, highsize 62, lowweight 0, highweight 1000 and amount 0 USD
  given a Grace GW with region US, lowsize 0, highsize 1000, lowweight 0, highweight 70 and amount 0 USD
  given a Bag B with trip T, nth 1, weight 60, length 20, width 20 and height 10
  given an Allowance A1 with trip T and nth 1
  when clerk C weighs B
  expect B is waived
  expect B's Free is done
