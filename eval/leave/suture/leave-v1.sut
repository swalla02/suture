  "rules": [
    {
      "name": "apart",
      "subject": "Employee",
      "filter": [],
      "body": {
        "Every": {
          "Cmp": {
            "left": {
              "Taken": {
                "of": {
                  "steps": []
                },
                "name": "leave time of Applications that are held per day from its from to its to",
                "ty": "Duration",
                "period": "day"
              }
            },
            "op": "Le",
            "right": {
              "Lit": {
                "Duration": 28800
              }
            }
          }
        }
      },
      "source": "for each Employee and day from their from to their to, the total leave time of their Applications that are held is at most 8 hours",
      "formula": "for each Employee e: sum(a in Application where a.employee = e and a is held, per day from a.from to a.to: the leave time from a.from to a.to) ≤ 8 hours",
      "paraphrase": "each employee on its own: the total leave time of its Applications that are held on any one day they span is at most 8 hours",
      "tier": "per-group",
      "period": "day",
      "fixed": false,
      "sources": [],
      "fresh": [],
      "applies": null
    },
    {
      "name": "balance",
      "subject": "Allocation",
      "filter": [],
      "body": {
        "Every": {
          "Cmp": {
            "left": {
              "Taken": {
                "of": {
                  "steps": []
                },
                "name": "days of Applications that are counted",
                "ty": "Duration",
                "period": null
              }
            },
            "op": "Le",
            "right": {
              "Path": {
                "steps": [
                  {
                    "Attr": "leaves"
                  }
                ]
              }
            }
          }
        }
      },
      "source": "the total days of each Allocation's Applications that are counted is at most its leaves",
      "formula": "for each Allocation a: sum(a2 in Application where a2.allocation = a and a2 is counted: a2.days) ≤ a.leaves",
      "paraphrase": "each allocation on its own: the total days of its Applications that are counted is at most its leaves",
      "tier": "per-group",
      "period": null,
      "fixed": false,
      "sources": [],
      "fresh": [],
      "applies": null
    },
    {
      "name": "consecutive",
      "subject": "Allocation",
      "filter": [],
      "body": {
        "Every": {
          "Or": [
            {
              "Cmp": {
                "left": {
                  "Taken": {
                    "of": {
                      "steps": []
                    },
                    "name": "number of Applications that are held per day from its from to its to",
                    "ty": "Count",
                    "period": "day",
                    "run": true
                  }
                },
                "op": "Le",
                "right": {
                  "Path": {
                    "steps": [
                      {
                        "Ref": "type"
                      },
                      {
                        "Attr": "longest"
                      }
                    ]
                  }
                }
              }
            },
            {
              "Cmp": {
                "left": {
                  "Path": {
                    "steps": [
                      {
                        "Ref": "type"
                      },
                      {
                        "Attr": "longest"
                      }
                    ]
                  }
                },
                "op": "Eq",
                "right": {
                  "Lit": {
                    "Count": 0
                  }
                }
              }
            }
          ]
        }
      },
      "source": "for each Allocation and day from their from to their to, the days in a row of their Applications that are held is at most its type's longest or its type's longest is 0",
      "formula": "for each Allocation a: (run(count(a2 in Application where a2.allocation = a and a2 is held, per day from a2.from to a2.to)) ≤ a.type.longest or a.type.longest = 0)",
      "paraphrase": "each allocation on its own: the days in a row its Applications that are held span, through any one day is at most its type's longest or its type's longest is 0",
      "tier": "per-group",
      "period": "day",
      "fixed": false,
      "sources": [],
      "fresh": [],
      "applies": null
    }
  ],
