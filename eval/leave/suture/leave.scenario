-- One scenario per test of hrms/hr/doctype/leave_application/test_leave_application.py
-- that the port covers (REQUIREMENTS.md lists the others), in the file's order.
-- `days` is the application's leave time. As hrms does with its holiday list,
-- the port counts the time calendar `leave` works (slice 61): 8 hours a day.

scenario "an application outside its allocation's period, or across two, is refused (test_validate_application_across_allocations)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Type T with name Validation
  and    a Allocation Last with employee E, type T, from 2025-01-01, to 2025-12-31 and leaves 240 hours
  and    a Allocation This with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 240 hours
  when   hr Admin applies a new Application L1 with employee E, type T, allocation This, approver A, from 2027-01-05 and to 2027-01-08
           is refused at the gate
  and    hr Admin applies a new Application L2 with employee E, type T, allocation This, approver A, from 2025-12-26 and to 2026-01-05
           is refused at the gate
  and    hr Admin applies a new Application L3 with employee E, type T, allocation Last, approver A, from 2025-12-26 and to 2026-01-05
           is refused at the gate
  and    hr Admin applies a new Application L4 with employee E, type T, allocation This, approver A, from 2026-01-05 and to 2026-01-08
  expect L4 is open

scenario "an application beyond the balance is refused, unless the type allows a negative balance (test_insufficient_leave_balance_validation)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Type T with name Validation
  and    a Type N with name Negative and negative yes
  and    a Allocation AT with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 16 hours
  and    a Allocation AN with employee E, type N, from 2026-01-01, to 2026-12-31 and leaves 16 hours
  when   hr Admin applies a new Application L1 with employee E, type T, allocation AT, approver A, from 2026-01-05 and to 2026-01-07
           is refused at the gate
  and    hr Admin applies a new Application L2 with employee E, type N, allocation AN, approver A, from 2026-01-05 and to 2026-01-07
  and    hr Admin approves L2
  expect L2 is approved

scenario "a second application beyond what is left is refused (test_leaves_allowed)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test
  and    a Allocation AT with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 40 hours
  when   it is 2026-03-08
  and    hr Admin applies a new Application L1 with employee E, type T, allocation AT, approver A, from 2026-03-01 and to 2026-03-03
  and    hr Admin approves L1
  and    hr Admin applies a new Application L2 with employee E, type T, allocation AT, approver A, from 2026-03-05 and to 2026-03-09
           is refused at the gate

scenario "an application that shares a day with an open or approved one is refused (test_overlap)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Employee F with user "other", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test
  and    a Allocation AT with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 240 hours
  and    a Allocation AF with employee F, type T, from 2026-01-01, to 2026-12-31 and leaves 240 hours
  when   employee E applies a new Application L1 with employee E, type T, allocation AT, approver A, from 2026-05-04 and to 2026-05-06
  and    employee E applies a new Application L2 with employee E, type T, allocation AT, approver A, from 2026-05-04 and to 2026-05-06
           is refused by rule apart
  and    employee E applies a new Application L3 with employee E, type T, allocation AT, approver A, from 2026-05-06 and to 2026-05-07
           is refused by rule apart
  and    employee F applies a new Application L4 with employee F, type T, allocation AF, approver A, from 2026-05-04 and to 2026-05-06
  and    approver A rejects L1
  and    employee E applies a new Application L5 with employee E, type T, allocation AT, approver A, from 2026-05-05 and to 2026-05-05
  expect L5 is open
  expect L4 is open

scenario "a type is applicable only some days after joining (test_applicable_after)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  when   it is 2026-03-08
  given  a Employee E with user "emp", company C, joined 2026-03-01 and approver A
  and    a Type Late with name Test and after 15 days
  and    a Type Any with name Test1
  and    a Allocation AL with employee E, type Late, from 2026-01-01, to 2026-12-31 and leaves 80 hours
  and    a Allocation AA with employee E, type Any, from 2026-01-01, to 2026-12-31 and leaves 80 hours
  when   hr Admin applies a new Application L1 with employee E, type Late, allocation AL, approver A, from 2026-03-01 and to 2026-03-05
           is refused at the gate
  and    hr Admin applies a new Application L2 with employee E, type Any, allocation AA, approver A, from 2026-03-01 and to 2026-03-05
  expect L2 is open

scenario "a leave longer than its type allows is refused (test_max_continuous_leaves)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test and longest 3
  and    a Allocation AT with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 80 hours
  when   hr Admin applies a new Application L1 with employee E, type T, allocation AT, approver A, from 2026-03-01 and to 2026-03-05
           is refused by rule consecutive

scenario "the application being approved does not count against itself (test_current_leave_on_submit)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Type Sick with name Sick
  and    a Allocation AS with employee E, type Sick, from 2026-10-01, to 2026-10-10 and leaves 8 hours
  when   hr Admin applies a new Application L1 with employee E, type Sick, allocation AS, approver A, from 2026-10-02 and to 2026-10-02
  and    hr Admin approves L1
  expect L1 is approved
  expect the total days of AS's Applications that are counted is 8 hours

scenario "an approved leave takes its days, and cancelling gives them back (test_creation_of_leave_ledger_entry_on_submit)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test1
  and    a Allocation AT with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 120 hours
  when   hr Admin applies a new Application L1 with employee E, type T, allocation AT, approver A, from 2026-01-02 and to 2026-01-05
  and    hr Admin approves L1
  expect the total days of AT's Applications that are counted is 32 hours
  when   hr Admin cancels L1
  expect L1 is cancelled
  expect the total days of AT's Applications that are counted is 0 hours

scenario "only the approver the application names approves it (after test_leave_approver_perms)":
  given  a Company C with name Test
  and    a Approver A with user "approver_perm"
  and    a Approver Other with user "test"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test
  and    a Allocation AT with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 240 hours
  when   employee E applies a new Application L1 with employee E, type T, allocation AT, approver A, from 2026-01-01 and to 2026-01-03
  and    approver Other approves L1
           is refused at the gate
  and    approver A approves L1
  expect L1 is approved

scenario "an application without an approver is refused (test_leave_approver_mandatory)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test
  and    a Allocation AT with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 240 hours
  when   hr Admin applies a new Application L1 with employee E, type T, allocation AT, from 2026-06-01 and to 2026-06-02
           is refused at the gate
  and    hr Admin applies a new Application L2 with employee E, type T, allocation AT, approver A, from 2026-06-01 and to 2026-06-02
  expect L2's approver's user is "approver"

scenario "an approver may approve their own leave where the company allows it (test_self_leave_approval_allowed)":
  given  a Company C with name Test and selfish yes
  and    a Approver Self with user "self"
  and    a Approver A with user "approver"
  and    a Employee E with user "self", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test
  and    a Allocation AT with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 240 hours
  when   hr Admin applies a new Application L1 with employee E, type T, allocation AT, approver Self, from 2026-06-01 and to 2026-06-02
  and    approver Self approves L1
  expect L1 is approved

scenario "an approver may not approve their own leave by default (test_self_leave_approval_not_allowed)":
  given  a Company C with name Test
  and    a Approver Self with user "self"
  and    a Approver A with user "approver"
  and    a Employee E with user "self", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test
  and    a Allocation AT with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 240 hours
  when   hr Admin applies a new Application L1 with employee E, type T, allocation AT, approver Self, from 2026-06-03 and to 2026-06-04
  and    approver Self approves L1
           is refused at the gate
  when   hr Admin applies a new Application L2 with employee E, type T, allocation AT, approver A, from 2026-06-08 and to 2026-06-09
  and    approver A approves L2
  expect L2 is approved

scenario "leaves allocated, taken and pending approval (test_get_leave_details_for_dashboard)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test
  and    a Allocation AT with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 240 hours
  when   hr Admin applies a new Application L1 with employee E, type T, allocation AT, approver A, from 2026-01-05 and to 2026-01-08
  and    hr Admin approves L1
  and    hr Admin applies a new Application L2 with employee E, type T, allocation AT, approver A, from 2026-01-09 and to 2026-01-09
  expect AT's leaves is 240 hours
  expect the total days of AT's Applications that are approved is 32 hours
  expect the total days of AT's Applications that are open is 8 hours

scenario "a discarded application is cancelled (test_status_on_discard)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test
  and    a Allocation AT with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 240 hours
  when   employee E applies a new Application L1 with employee E, type T, allocation AT, approver A, from 2026-01-01 and to 2026-01-05
  and    employee E discards L1
  expect L1 is cancelled

scenario "another employee may not approve or discard an application (after test_leave_access_control_flow)":
  given  a Company C with name Test
  and    a Approver A with user "test_approver_access"
  and    a Employee E with user "test_leave_access", company C, joined 2010-01-01 and approver A
  and    a Employee R with user "unauth_user", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test
  and    a Allocation AT with employee E, type T, from 2026-04-01, to 2027-03-31 and leaves 240 hours
  when   employee E applies a new Application L1 with employee E, type T, allocation AT, approver A, from 2026-04-11 and to 2026-04-11
  and    employee R approves L1
           is refused at the gate
  and    employee R discards L1
           is refused at the gate
  and    approver A approves L1
  expect L1 is approved

scenario "leave in a row across applications is no longer than its type allows (test_max_consecutive_leaves_across_leave_applications)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test and longest 10
  and    a Allocation AT with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 240 hours
  when   hr Admin applies a new Application B with employee E, type T, allocation AT, approver A, from 2026-01-30 and to 2026-02-03
  and    hr Admin applies a new Application F with employee E, type T, allocation AT, approver A, from 2026-02-06 and to 2026-02-10
  and    hr Admin applies a new Application L with employee E, type T, allocation AT, approver A, from 2026-02-04 and to 2026-02-05
           is refused by rule consecutive
  and    hr Admin applies a new Application S with employee E, type T, allocation AT, approver A, from 2026-02-04 and to 2026-02-04
  expect S is open
  when   approver A rejects B
  and    hr Admin applies a new Application M with employee E, type T, allocation AT, approver A, from 2026-02-05 and to 2026-02-05
  expect M is open

scenario "a half day on a day off works no time and is refused (after test_half_day_date_cannot_be_holiday)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test
  and    a Allocation AT with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 240 hours
  when   hr Admin applies a new Application L1 with employee E, type T, allocation AT, approver A, from 2026-07-01 9:00 and to 2026-07-01 13:00
           is refused at the gate
  and    hr Admin applies a new Application L2 with employee E, type T, allocation AT, approver A, from 2026-07-02 9:00 and to 2026-07-02 13:00
  expect L2's days is 4 hours

scenario "a leave across two days off counts the others (test_leave_days_across_two_holiday_lists)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test
  and    a Allocation AT with employee E, type T, from 2026-07-30, to 2026-08-20 and leaves 80 hours
  when   hr Admin applies a new Application L1 with employee E, type T, allocation AT, approver A, from 2026-08-08 and to 2026-08-12
  expect L1's days is 24 hours

scenario "two half days may share a date, a third may not (after test_overlap_with_half_day_1)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test
  and    a Allocation AT with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 240 hours
  when   hr Admin applies a new Application L1 with employee E, type T, allocation AT, approver A, from 2026-09-03 9:00 and to 2026-09-03 13:00
  and    hr Admin applies a new Application L2 with employee E, type T, allocation AT, approver A, from 2026-09-03 13:00 and to 2026-09-03 17:00
  and    hr Admin applies a new Application L3 with employee E, type T, allocation AT, approver A, from 2026-09-03 9:00 and to 2026-09-03 13:00
           is refused by rule apart
  expect L1 is open
  and    L2 is open

scenario "a half day on a date already on leave is refused (test_overlap_with_half_day_2)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test
  and    a Allocation AT with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 240 hours
  when   hr Admin applies a new Application L1 with employee E, type T, allocation AT, approver A, from 2026-09-01 and to 2026-09-05
  and    hr Admin applies a new Application L2 with employee E, type T, allocation AT, approver A, from 2026-09-01 9:00 and to 2026-09-01 13:00
           is refused by rule apart
  expect L1 is open

scenario "a leave that ends on a half day leaves the other half (test_overlap_with_half_day_3)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test
  and    a Allocation AT with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 240 hours
  when   hr Admin applies a new Application L1 with employee E, type T, allocation AT, approver A, from 2026-09-01 and to 2026-09-05 13:00
  and    hr Admin applies a new Application L2 with employee E, type T, allocation AT, approver A, from 2026-09-04 and to 2026-09-07
           is refused by rule apart
  and    hr Admin applies a new Application L3 with employee E, type T, allocation AT, approver A, from 2026-09-05 13:00 and to 2026-09-07
  expect L1's days is 36 hours
  and    L3's days is 20 hours

scenario "a half day on a day already on leave is refused (test_overlap_with_half_day_on_today)":
  given  a Company C with name Test
  and    a Approver A with user "approver"
  and    a Employee E with user "emp", company C, joined 2010-01-01 and approver A
  and    a Type T with name Test
  and    a Allocation AT with employee E, type T, from 2026-01-01, to 2026-12-31 and leaves 240 hours
  when   hr Admin applies a new Application L1 with employee E, type T, allocation AT, approver A, from 2026-09-10 and to 2026-09-10
  and    hr Admin applies a new Application L2 with employee E, type T, allocation AT, approver A, from 2026-09-10 9:00 and to 2026-09-10 13:00
           is refused by rule apart
  expect L1 is open

