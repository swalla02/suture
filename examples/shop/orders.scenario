-- The shop's orders against simulated payment, form and carrier services.
scenario "shipped from stock in its country with the cheapest carrier":
  given  a Country DE with code "DE"
  and    a Country FR with code "FR"
  and    a Country IR with code "IR" and restricted yes
  and    a Customer Ada with name Ada and country DE
  and    a Customer Eve with name Eve and country FR
  and    a Customer Ira with name Ira and country IR
  and    a Product Kettle with name Kettle and price 30 EUR
  and    a Product Wine with name Wine and price 20 EUR
  and    a Warehouse BER with code BER and country DE
  and    a Warehouse LYS with code LYS and country FR
  and    a Carrier DHL with name DHL, countries {DE, FR} and fee 9 EUR
  and    a Carrier Hermes with name Hermes, countries DE and fee 5 EUR
  and    a Stock LY1 with warehouse LYS, product Kettle and units 5
  and    a Stock BE1 with warehouse BER, product Kettle and units 5
  when   a new Order O1 with customer Ada
         and a line with product Kettle and quantity 2
  and    payments answers captured
  and    carriers answers delivered
  expect O1 is settled
  expect the total quantity taken from BE1 is 2
  expect the total quantity taken from LY1 is 0
  expect O1's Shipment's Carrier's name is "Hermes"

scenario "a lost parcel is re-shipped from another warehouse":
  given  a Country DE with code "DE"
  and    a Country FR with code "FR"
  and    a Country IR with code "IR" and restricted yes
  and    a Customer Ada with name Ada and country DE
  and    a Customer Eve with name Eve and country FR
  and    a Customer Ira with name Ira and country IR
  and    a Product Kettle with name Kettle and price 30 EUR
  and    a Product Wine with name Wine and price 20 EUR
  and    a Warehouse BER with code BER and country DE
  and    a Warehouse LYS with code LYS and country FR
  and    a Carrier DHL with name DHL, countries {DE, FR} and fee 9 EUR
  and    a Carrier Hermes with name Hermes, countries DE and fee 5 EUR
  and    a Stock BE1 with warehouse BER, product Kettle and units 1
  and    a Stock LY1 with warehouse LYS, product Kettle and units 5
  when   a new Order P1 with customer Ada
         and a line with product Kettle and quantity 1
  and    payments answers captured
  and    carriers answers lost
  and    carriers answers delivered
  expect P1 is settled
  expect the number of P1's Shipments is 2
  expect the total quantity taken from BE1 is 1
  expect the total quantity taken from LY1 is 1

scenario "no stock anywhere refunds after 2 days":
  given  a Country DE with code "DE"
  and    a Country FR with code "FR"
  and    a Country IR with code "IR" and restricted yes
  and    a Customer Ada with name Ada and country DE
  and    a Customer Eve with name Eve and country FR
  and    a Customer Ira with name Ira and country IR
  and    a Product Kettle with name Kettle and price 30 EUR
  and    a Product Wine with name Wine and price 20 EUR
  and    a Warehouse BER with code BER and country DE
  and    a Warehouse LYS with code LYS and country FR
  and    a Carrier DHL with name DHL, countries {DE, FR} and fee 9 EUR
  and    a Carrier Hermes with name Hermes, countries DE and fee 5 EUR
  when   a new Order N1 with customer Ada
         and a line with product Wine and quantity 1
  and    payments answers captured
  expect N1 is not settled
  when   2 days pass
  and    payments answers refunded
  expect N1's Refund is refunded
  expect N1 is settled
  expect N1 has no Shipment

scenario "a restricted country refunds at once":
  given  a Country DE with code "DE"
  and    a Country FR with code "FR"
  and    a Country IR with code "IR" and restricted yes
  and    a Customer Ada with name Ada and country DE
  and    a Customer Eve with name Eve and country FR
  and    a Customer Ira with name Ira and country IR
  and    a Product Kettle with name Kettle and price 30 EUR
  and    a Product Wine with name Wine and price 20 EUR
  and    a Warehouse BER with code BER and country DE
  and    a Warehouse LYS with code LYS and country FR
  and    a Carrier DHL with name DHL, countries {DE, FR} and fee 9 EUR
  and    a Carrier Hermes with name Hermes, countries DE and fee 5 EUR
  and    a Stock BE1 with warehouse BER, product Kettle and units 5
  when   a new Order R1 with customer Ira
         and a line with product Kettle and quantity 1
  and    payments answers captured
  and    payments answers refunded
  expect R1's Refund is refunded
  expect R1 is settled
  expect R1 has no Shipment

scenario "a cancelled order releases its stock":
  given  a Country DE with code "DE"
  and    a Country FR with code "FR"
  and    a Country IR with code "IR" and restricted yes
  and    a Customer Ada with name Ada and country DE
  and    a Customer Eve with name Eve and country FR
  and    a Customer Ira with name Ira and country IR
  and    a Product Kettle with name Kettle and price 30 EUR
  and    a Product Wine with name Wine and price 20 EUR
  and    a Warehouse BER with code BER and country DE
  and    a Warehouse LYS with code LYS and country FR
  and    a Carrier DHL with name DHL, countries {DE, FR} and fee 9 EUR
  and    a Carrier Hermes with name Hermes, countries DE and fee 5 EUR
  and    a Stock BE1 with warehouse BER, product Kettle and units 5
  when   a new Order D1 with customer Ada
         and a line with product Kettle and quantity 3
  expect the total quantity taken from BE1 is 3
  when   payments answers declined
  expect D1 is cancelled
  expect D1 has no Shipment
  expect the total quantity taken from BE1 is 0

scenario "a monthly refund cap makes a refund wait":
  given  a Country DE with code "DE"
  and    a Country FR with code "FR"
  and    a Country IR with code "IR" and restricted yes
  and    a Customer Ada with name Ada and country DE
  and    a Customer Eve with name Eve and country FR
  and    a Customer Ira with name Ira and country IR
  and    a Product Kettle with name Kettle and price 30 EUR
  and    a Product Wine with name Wine and price 20 EUR
  and    a Warehouse BER with code BER and country DE
  and    a Warehouse LYS with code LYS and country FR
  and    a Carrier DHL with name DHL, countries {DE, FR} and fee 9 EUR
  and    a Carrier Hermes with name Hermes, countries DE and fee 5 EUR
  when   a new Order M1 with customer Ira
         and a line with product Kettle and quantity 20
  and    payments answers captured for M1
  and    payments answers refunded for M1
  and    a new Order M2 with customer Ira
         and a line with product Kettle and quantity 15
  and    payments answers captured for M2
  expect M1 is settled
  expect M2 is not settled
  expect M2 has a Refund

scenario "a French order with alcohol":
  given  a Country DE with code "DE"
  and    a Country FR with code "FR"
  and    a Country IR with code "IR" and restricted yes
  and    a Customer Ada with name Ada and country DE
  and    a Customer Eve with name Eve and country FR
  and    a Customer Ira with name Ira and country IR
  and    a Product Kettle with name Kettle and price 30 EUR
  and    a Product Wine with name Wine and price 20 EUR
  and    a Warehouse BER with code BER and country DE
  and    a Warehouse LYS with code LYS and country FR
  and    a Carrier DHL with name DHL, countries {DE, FR} and fee 9 EUR
  and    a Carrier Hermes with name Hermes, countries DE and fee 5 EUR
  and    a Stock LY1 with warehouse LYS, product Wine and units 10
  when   a new Order F1 with customer Eve
         and a line with product Wine and quantity 6
  and    payments answers captured
  and    forms answers filled with value 150 EUR and contents alcohol
  and    forms answers filled with value 100 EUR and contents alcohol
  and    forms answers filled with licence ""
  and    forms answers filled with licence "L-77"
  and    carriers answers delivered
  expect F1 is paid
  expect F1 is settled

scenario "a payment service that never answers":
  given  a Country DE with code "DE"
  and    a Country FR with code "FR"
  and    a Country IR with code "IR" and restricted yes
  and    a Customer Ada with name Ada and country DE
  and    a Customer Eve with name Eve and country FR
  and    a Customer Ira with name Ira and country IR
  and    a Product Kettle with name Kettle and price 30 EUR
  and    a Product Wine with name Wine and price 20 EUR
  and    a Warehouse BER with code BER and country DE
  and    a Warehouse LYS with code LYS and country FR
  and    a Carrier DHL with name DHL, countries {DE, FR} and fee 9 EUR
  and    a Carrier Hermes with name Hermes, countries DE and fee 5 EUR
  and    a Stock BE1 with warehouse BER, product Kettle and units 5
  when   a new Order S1 with customer Ada
         and a line with product Kettle and quantity 1
  and    90 seconds pass
  expect S1's Payment is timed out
  expect S1 is not settled
  when   3 days pass
  expect an alert for S1
  expect S1 is not paid

scenario "an answer after the time-out":
  given  a Country DE with code "DE"
  and    a Country FR with code "FR"
  and    a Country IR with code "IR" and restricted yes
  and    a Customer Ada with name Ada and country DE
  and    a Customer Eve with name Eve and country FR
  and    a Customer Ira with name Ira and country IR
  and    a Product Kettle with name Kettle and price 30 EUR
  and    a Product Wine with name Wine and price 20 EUR
  and    a Warehouse BER with code BER and country DE
  and    a Warehouse LYS with code LYS and country FR
  and    a Carrier DHL with name DHL, countries {DE, FR} and fee 9 EUR
  and    a Carrier Hermes with name Hermes, countries DE and fee 5 EUR
  and    a Stock BE1 with warehouse BER, product Kettle and units 5
  when   a new Order L1 with customer Ada
         and a line with product Kettle and quantity 1
  and    90 seconds pass
  and    payments answers captured
  expect L1's Payment is timed out
  expect L1 is not paid
