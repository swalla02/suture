-- Three orders against simulated payment, form and carrier services.
scenario "a French order with alcohol":
  when   a new Order O1 with country France and total 120 EUR
  and    payments answers captured
  and    forms answers filled with value 150 EUR and contents alcohol
  and    forms answers filled with value 100 EUR and contents alcohol
  and    forms answers filled with licence ""
  and    forms answers filled with licence "L-77"
  and    carriers answers delivered
  expect O1 is paid
  expect O1 is settled

scenario "a Japanese order":
  when   a new Order J1 with country Japan and total 80 EUR
  and    payments answers captured
  and    carriers answers delivered
  expect J1 is settled

scenario "a declined payment":
  when   a new Order D1 with country Japan and total 50 EUR
  and    payments answers declined
  expect D1 is cancelled
  expect D1 is not paid
